# Python
__pycache__/
*.py[cod]
.pytest_cache/

# uv / virtualenv
.venv/

# Databricks Asset Bundle build output
.databricks/

# Claude Code local, per-machine settings (settings.json is shared, .local is not)
.claude/settings.local.json

# Terraform: state can contain service principal secrets in plaintext, and
# tfvars carries subscription/tenant identifiers.
.terraform/
*.tfstate
*.tfstate.*
crash.log

# Generated by infra/bootstrap.sh for local runs. Not secret, but they name the
# tenant, subscription and Databricks account, and this repository is public.
# CI gets the same values from GitHub variables instead.
*.tfvars
*.tfbackend

.vscode/